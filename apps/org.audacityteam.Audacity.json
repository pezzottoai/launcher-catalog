{
  "$schema": "../schema/app.schema.json",
  "schema_version": 1,
  "id": "org.audacityteam.Audacity",
  "name": "Audacity",
  "summary": "Record and edit audio",
  "developer": "Audacity team",
  "license": "GPL-3.0-or-later",
  "homepage": "https://www.audacityteam.org",
  "source_code": "https://github.com/audacity/audacity",
  "topics": [
    "audio-video"
  ],
  "tags": [
    "audio",
    "recording",
    "podcast"
  ],
  "installers": [
    {
      "platform": "linux",
      "kind": "flatpak",
      "ref": "org.audacityteam.Audacity"
    },
    {
      "platform": "windows",
      "kind": "winget",
      "package": "Audacity.Audacity"
    },
    {
      "platform": "macos",
      "kind": "homebrew",
      "package": "audacity",
      "cask": true
    }
  ]
