{
  "$schema": "../schema/app.schema.json",
  "schema_version": 1,
  "id": "com.getartcraft.PhotoCraft",
  "name": "PhotoCraft",
  "summary": "Image editor for photos and raster artwork",
  "description": "PhotoCraft is an open-source photo and image editor written from scratch in pure Rust.\n\nPart of the ArtCraft crafting apps.",
  "developer": "ArtCraft",
  "license": "MIT OR Apache-2.0",
  "homepage": "https://getartcraft.com/apps/photocraft",
  "source_code": "https://github.com/storytold/photocraft",
  "icon": "https://getartcraft.com/images/apps/photocraft/icon.webp",
  "topics": [
    "graphics"
  ],
  "tags": [
    "artcraft",
    "photo",
    "image",
    "raster",
    "rust"
  ],
  "installers": [
    {
      "platform": "linux",
      "arch": [
        "x86_64"
      ],
      "kind": "download",
      "format": "appimage",
      "github": {
        "repo": "storytold/photocraft",
        "asset": "^photocraft-[0-9][0-9A-Za-z.+-]*-linux-x86_64\\.AppImage$"
      }
    },
    {
      "platform": "linux",
      "arch": [
        "aarch64"
      ],
      "kind": "download",
      "format": "appimage",
      "github": {
        "repo": "storytold/photocraft",
        "asset": "^photocraft-[0-9][0-9A-Za-z.+-]*-linux-aarch64\\.AppImage$"
      }
    },
    {
      "platform": "windows",
      "arch": [
        "x86_64"
      ],
      "kind": "download",
      "format": "archive",
      "github": {
        "repo": "storytold/photocraft",
        "asset": "^photocraft-[0-9][0-9A-Za-z.+-]*-windows-x64-portable\\.zip$"
      },
      "exec": "photocraft.exe"
    },
    {
      "platform": "windows",
      "arch": [
        "aarch64"
      ],
      "kind": "download",
      "format": "archive",
      "github": {
        "repo": "storytold/photocraft",
        "asset": "^photocraft-[0-9][0-9A-Za-z.+-]*-windows-arm64-portable\\.zip$"
      },
      "exec": "photocraft.exe"
    },
    {
      "platform": "windows",
      "arch": [
        "x86_64"
      ],
      "kind": "download",
      "format": "installer",
      "github": {
        "repo": "storytold/photocraft",
        "asset": "^photocraft-[0-9][0-9A-Za-z.+-]*-windows-x64\\.msi$"
      }
    },
    {
      "platform": "macos",
      "kind": "download",
      "format": "installer",
      "github": {
        "repo": "storytold/photocraft",
        "asset": "^photocraft-[0-9][0-9A-Za-z.+-]*-macos-universal\\.dmg$"
      }
    }
  ]
}
