{
  "$schema": "../schema/app.schema.json",
  "schema_version": 1,
  "id": "com.getartcraft.LightCraft",
  "name": "LightCraft",
  "summary": "Photo library and non-destructive raw developer",
  "description": "LightCraft is an open-source photo library and non-destructive raw photo developer written from scratch in pure Rust.\n\nPart of the ArtCraft crafting apps.",
  "developer": "ArtCraft",
  "license": "MIT OR Apache-2.0",
  "homepage": "https://getartcraft.com/apps/lightcraft",
  "source_code": "https://github.com/storytold/lightcraft",
  "icon": "https://getartcraft.com/images/apps/lightcraft/icon.webp",
  "topics": [
    "graphics"
  ],
  "tags": [
    "artcraft",
    "photo",
    "raw",
    "catalog",
    "rust"
  ],
  "installers": [
    {
      "platform": "linux",
      "arch": [
        "x86_64"
      ],
      "kind": "download",
      "format": "appimage",
      "github": {
        "repo": "storytold/lightcraft",
        "asset": "^lightcraft-[0-9][0-9A-Za-z.+-]*-linux-x86_64\\.AppImage$"
      }
    },
    {
      "platform": "linux",
      "arch": [
        "aarch64"
      ],
      "kind": "download",
      "format": "appimage",
      "github": {
        "repo": "storytold/lightcraft",
        "asset": "^lightcraft-[0-9][0-9A-Za-z.+-]*-linux-aarch64\\.AppImage$"
      }
    },
    {
      "platform": "windows",
      "arch": [
        "x86_64"
      ],
      "kind": "download",
      "format": "archive",
      "github": {
        "repo": "storytold/lightcraft",
        "asset": "^lightcraft-[0-9][0-9A-Za-z.+-]*-windows-x64-portable\\.zip$"
      },
      "exec": "lightcraft.exe"
    },
    {
      "platform": "windows",
      "arch": [
        "aarch64"
      ],
      "kind": "download",
      "format": "archive",
      "github": {
        "repo": "storytold/lightcraft",
        "asset": "^lightcraft-[0-9][0-9A-Za-z.+-]*-windows-arm64-portable\\.zip$"
      },
      "exec": "lightcraft.exe"
    },
    {
      "platform": "windows",
      "arch": [
        "x86_64"
      ],
      "kind": "download",
      "format": "installer",
      "github": {
        "repo": "storytold/lightcraft",
        "asset": "^lightcraft-[0-9][0-9A-Za-z.+-]*-windows-x64\\.msi$"
      }
    },
    {
      "platform": "macos",
      "kind": "download",
      "format": "installer",
      "github": {
        "repo": "storytold/lightcraft",
        "asset": "^lightcraft-[0-9][0-9A-Za-z.+-]*-macos-universal\\.dmg$"
      }
    }
  ]
}
