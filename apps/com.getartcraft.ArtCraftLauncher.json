{
  "$schema": "../schema/app.schema.json",
  "schema_version": 1,
  "id": "com.getartcraft.ArtCraftLauncher",
  "name": "ArtCraft Launcher",
  "summary": "Installs every ArtCraft app and keeps them up to date",
  "description": "The ArtCraft Launcher installs, updates and launches all the ArtCraft crafting apps.",
  "developer": "ArtCraft",
  "license": "MIT OR Apache-2.0",
  "homepage": "https://getartcraft.com/apps",
  "source_code": "https://github.com/storytold/craft-launcher",
  "icon": "https://raw.githubusercontent.com/storytold/craft-launcher/main/assets/app-icon/artcraft-launcher-1024.png",
  "topics": [
    "utilities"
  ],
  "tags": [
    "artcraft",
    "launcher",
    "updater"
  ],
  "installers": [
    {
      "platform": "linux",
      "arch": [
        "x86_64"
      ],
      "kind": "download",
      "format": "appimage",
      "github": {
        "repo": "storytold/craft-launcher",
        "asset": "^artcraft-launcher-[0-9][0-9A-Za-z.+-]*-linux-x86_64\\.AppImage$"
      }
    },
    {
      "platform": "linux",
      "arch": [
        "aarch64"
      ],
      "kind": "download",
      "format": "appimage",
      "github": {
        "repo": "storytold/craft-launcher",
        "asset": "^artcraft-launcher-[0-9][0-9A-Za-z.+-]*-linux-aarch64\\.AppImage$"
      }
    },
    {
      "platform": "windows",
      "arch": [
        "x86_64"
      ],
      "kind": "download",
      "format": "archive",
      "github": {
        "repo": "storytold/craft-launcher",
        "asset": "^artcraft-launcher-[0-9][0-9A-Za-z.+-]*-windows-x64-portable\\.zip$"
      },
      "exec": "artcraft-launcher.exe"
    },
    {
      "platform": "windows",
      "arch": [
        "aarch64"
      ],
      "kind": "download",
      "format": "archive",
      "github": {
        "repo": "storytold/craft-launcher",
        "asset": "^artcraft-launcher-[0-9][0-9A-Za-z.+-]*-windows-arm64-portable\\.zip$"
      },
      "exec": "artcraft-launcher.exe"
    },
    {
      "platform": "windows",
      "arch": [
        "x86_64"
      ],
      "kind": "download",
      "format": "installer",
      "github": {
        "repo": "storytold/craft-launcher",
        "asset": "^artcraft-launcher-[0-9][0-9A-Za-z.+-]*-windows-x64\\.msi$"
      }
    },
    {
      "platform": "macos",
      "kind": "download",
      "format": "installer",
      "github": {
        "repo": "storytold/craft-launcher",
        "asset": "^artcraft-launcher-[0-9][0-9A-Za-z.+-]*-macos-universal\\.dmg$"
      }
    }
  ]
}
