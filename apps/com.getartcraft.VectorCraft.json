{
  "$schema": "../schema/app.schema.json",
  "schema_version": 1,
  "id": "com.getartcraft.VectorCraft",
  "name": "VectorCraft",
  "summary": "Vector illustration and graphic design",
  "description": "VectorCraft is an open-source vector art tool written from scratch in pure Rust.\n\nPart of the ArtCraft crafting apps.",
  "developer": "ArtCraft",
  "license": "MIT OR Apache-2.0",
  "homepage": "https://getartcraft.com/apps/vectorcraft",
  "source_code": "https://github.com/storytold/vectorcraft",
  "icon": "https://getartcraft.com/images/apps/vectorcraft/icon.webp",
  "topics": [
    "graphics"
  ],
  "tags": [
    "artcraft",
    "vector",
    "svg",
    "illustration",
    "rust"
  ],
  "installers": [
    {
      "platform": "linux",
      "arch": [
        "x86_64"
      ],
      "kind": "download",
      "format": "appimage",
      "github": {
        "repo": "storytold/vectorcraft",
        "asset": "^vectorcraft-[0-9][0-9A-Za-z.+-]*-linux-x86_64\\.AppImage$"
      }
    },
    {
      "platform": "linux",
      "arch": [
        "aarch64"
      ],
      "kind": "download",
      "format": "appimage",
      "github": {
        "repo": "storytold/vectorcraft",
        "asset": "^vectorcraft-[0-9][0-9A-Za-z.+-]*-linux-aarch64\\.AppImage$"
      }
    },
    {
      "platform": "windows",
      "arch": [
        "x86_64"
      ],
      "kind": "download",
      "format": "archive",
      "github": {
        "repo": "storytold/vectorcraft",
        "asset": "^vectorcraft-[0-9][0-9A-Za-z.+-]*-windows-x64-portable\\.zip$"
      },
      "exec": "vectorcraft.exe"
    },
    {
      "platform": "windows",
      "arch": [
        "aarch64"
      ],
      "kind": "download",
      "format": "archive",
      "github": {
        "repo": "storytold/vectorcraft",
        "asset": "^vectorcraft-[0-9][0-9A-Za-z.+-]*-windows-arm64-portable\\.zip$"
      },
      "exec": "vectorcraft.exe"
    },
    {
      "platform": "windows",
      "arch": [
        "x86_64"
      ],
      "kind": "download",
      "format": "installer",
      "github": {
        "repo": "storytold/vectorcraft",
        "asset": "^vectorcraft-[0-9][0-9A-Za-z.+-]*-windows-x64\\.msi$"
      }
    },
    {
      "platform": "macos",
      "kind": "download",
      "format": "installer",
      "github": {
        "repo": "storytold/vectorcraft",
        "asset": "^vectorcraft-[0-9][0-9A-Za-z.+-]*-macos-universal\\.dmg$"
      }
    }
  ]
}
