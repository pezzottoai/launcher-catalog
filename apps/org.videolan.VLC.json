{
  "$schema": "../schema/app.schema.json",
  "schema_version": 1,
  "id": "org.videolan.VLC",
  "name": "VLC",
  "summary": "Media player for most multimedia files and streams",
  "developer": "VideoLAN",
  "license": "GPL-2.0-or-later",
  "homepage": "https://www.videolan.org/vlc/",
  "source_code": "https://code.videolan.org/videolan/vlc",
