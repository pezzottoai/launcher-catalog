{
  "$schema": "../schema/app.schema.json",
  "schema_version": 1,
  "id": "com.getartcraft.EffectCraft",
  "name": "EffectCraft",
  "summary": "Motion graphics, compositing and VFX",
  "description": "EffectCraft is an open-source motion graphics and compositing tool written from scratch in pure Rust.\n\nPart of the ArtCraft crafting apps.",
  "developer": "ArtCraft",
  "license": "MIT OR Apache-2.0",
  "homepage": "https://getartcraft.com/apps/effectcraft",
  "source_code": "https://github.com/storytold/effectcraft",
  "icon": "https://getartcraft.com/images/apps/effectcraft/icon.webp",
  "topics": [
    "audio-video",
    "graphics"
  ],
  "tags": [
    "artcraft",
    "vfx",
    "motion graphics",
    "compositing",
    "rust"
  ],
  "installers": [
    {
      "platform": "linux",
      "arch": [
        "x86_64"
      ],
      "kind": "download",
      "format": "appimage",
      "github": {
        "repo": "storytold/effectcraft",
        "asset": "^effectcraft-[0-9][0-9A-Za-z.+-]*-linux-x86_64\\.AppImage$"
      }
    },
    {
      "platform": "linux",
      "arch": [
        "aarch64"
      ],
      "kind": "download",
      "format": "appimage",
      "github": {
        "repo": "storytold/effectcraft",
        "asset": "^effectcraft-[0-9][0-9A-Za-z.+-]*-linux-aarch64\\.AppImage$"
      }
    },
    {
      "platform": "windows",
      "arch": [
        "x86_64"
      ],
      "kind": "download",
      "format": "archive",
      "github": {
        "repo": "storytold/effectcraft",
        "asset": "^effectcraft-[0-9][0-9A-Za-z.+-]*-windows-x64-portable\\.zip$"
      },
      "exec": "effectcraft.exe"
    },
    {
      "platform": "windows",
      "arch": [
        "aarch64"
      ],
      "kind": "download",
      "format": "archive",
      "github": {
        "repo": "storytold/effectcraft",
        "asset": "^effectcraft-[0-9][0-9A-Za-z.+-]*-windows-arm64-portable\\.zip$"
      },
      "exec": "effectcraft.exe"
    },
    {
      "platform": "windows",
      "arch": [
        "x86_64"
      ],
      "kind": "download",
      "format": "installer",
      "github": {
        "repo": "storytold/effectcraft",
        "asset": "^effectcraft-[0-9][0-9A-Za-z.+-]*-windows-x64\\.msi$"
      }
    },
    {
      "platform": "macos",
      "kind": "download",
      "format": "installer",
      "github": {
        "repo": "storytold/effectcraft",
        "asset": "^effectcraft-[0-9][0-9A-Za-z.+-]*-macos-universal\\.dmg$"
      }
    }
  ]
}
