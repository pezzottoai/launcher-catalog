{
  "$schema": "../schema/app.schema.json",
  "schema_version": 1,
  "id": "org.libreoffice.LibreOffice",
  "name": "LibreOffice",
  "summary": "Office suite: documents, spreadsheets, presentations, drawings",
  "developer": "The Document Foundation",
  "license": "MPL-2.0",
  "homepage": "https://www.libreoffice.org",
  "source_code": "https://git.libreoffice.org/core",
  "topics": [
    "office"
  ],
